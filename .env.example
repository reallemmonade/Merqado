# Database (Turso / libSQL). For local dev, leave the URL as a file path.
TURSO_DATABASE_URL=file:.data/local.db
TURSO_AUTH_TOKEN=

# 32-byte key, base64. Encrypts firms' AI and storage credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MERQADO_SECRET_KEY=

# Managed AI (used when a firm's billing mode is "managed", i.e. Merqado pays and meters).
ANTHROPIC_API_KEY=

# Local storage root for dev uploads when a firm has no cloud storage connected.
LOCAL_STORAGE_DIR=.data/uploads

# Temporary dev sign-in until SSO lands. Never set in production.
DEV_USER_EMAIL=
